{
  "manifest_version": 3,
  "name": "Video Download Helper — Free Video Downloader",
  "version": "0.5.0",
  "description": "Find video files on the current page and save them. Free, open source, no accounts or tracking.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage", "downloads", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Video Download Helper", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } }
}
